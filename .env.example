# Data-Pilot NVIDIA NIM Configuration
# Copy this file to .env and fill in your values

# Required: NVIDIA API Key
# Get your key from https://build.nvidia.com/
NVIDIA_API_KEY=your_api_key_here

# Optional: NIM Base URL (default: https://integrate.api.nvidia.com/v1)
# Use this if you're running a local NIM or using a different endpoint
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Model name (default: nvidia/nemotron-3.5-lightning-30b-a3b)
# Other options: meta/llama-3.1-70b-instruct, google/gemma-2-27b-it, etc.
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional: Generation temperature (default: 0.2)
# Lower = more deterministic, Higher = more creative
# NVIDIA_TEMPERATURE=0.2

# Optional: Max tokens for response (default: 2000)
# NVIDIA_MAX_TOKENS=2000